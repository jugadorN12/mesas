{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/",
        "destination": "/cubano-bar-mesas.html",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "functions/**",
      "**/.*",
      "**/node_modules/**",
      "*.bat",
      "*.cmd",
      "*.ps1",
      "*.sh",
      "*.md",
      "*.log",
      "*.bak",
      "seed_local.js",
      "scratch/**"
    ],
    "cleanUrls": true
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8085
    },
    "hosting": {
      "port": 5000
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
