rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función segura para obtener el rol
    function hasRole(role) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == role;
    }

    function anyRole(roles) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role in roles;
    }

    // Helper para verificar si un cliente demo externo no está bloqueado
    function demoNoBloqueada(clienteId) {
      return !exists(/databases/$(database)/documents/clientes_externos/$(clienteId))
        || !('bloqueada' in get(/databases/$(database)/documents/clientes_externos/$(clienteId)).data)
        || get(/databases/$(database)/documents/clientes_externos/$(clienteId)).data.bloqueada != true;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.token.email == userId ||
        hasRole('admin') ||
        (hasRole('admin_joseo') && resource.data.role in ['assistant_joseo', 'boleteria_joseo'])
      );
      allow write: if hasRole('admin') ||
        (hasRole('admin_joseo') && request.resource.data.role in ['assistant_joseo', 'boleteria_joseo']);
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if hasRole('admin') || (configId == 'joseo' && hasRole('admin_joseo')) || (configId != 'joseo' && hasRole('assistant'));
    }

    match /reservas/{mesaId} {
      allow read: if true;

      allow create: if (request.resource.data.status in ['pendiente', 'disputa']
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.contacto is string
        && request.resource.data.ts is int)
        || anyRole(['admin', 'assistant', 'boleteria']);

      allow update: if anyRole(['admin', 'assistant', 'boleteria']);

      allow delete: if anyRole(['admin', 'assistant', 'boleteria'])
        || (resource.data.status == 'disputa' && resource.data.expiresAt <= request.time.toMillis());
    }

    match /reservas_fecha2/{mesaId} {
      allow read: if true;

      allow create: if (request.resource.data.status in ['pendiente', 'disputa']
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.contacto is string
        && request.resource.data.ts is int)
        || anyRole(['admin', 'assistant', 'boleteria']);

      allow update: if anyRole(['admin', 'assistant', 'boleteria']);

      allow delete: if anyRole(['admin', 'assistant', 'boleteria'])
        || (resource.data.status == 'disputa' && resource.data.expiresAt <= request.time.toMillis());
    }

    match /caja_movimientos/{movimientoId} {
      allow read, write: if anyRole(['admin', 'assistant', 'boleteria']);
    }

    match /visitas_cubano/{visitaId} {
      allow read: if hasRole('admin');

      allow create: if (request.resource.data.ciudad is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.timestamp is int
        && request.resource.data.fecha is string)
        || hasRole('admin');

      allow update, delete: if hasRole('admin');
    }

    // --- Soporte multi-tenant para cliente 'joseo' ---

    match /reservas_joseo/{mesaId} {
      allow read: if true;

      allow create: if (request.resource.data.status in ['pendiente', 'disputa']
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.contacto is string
        && request.resource.data.ts is int)
        || anyRole(['admin', 'admin_joseo', 'assistant_joseo', 'boleteria_joseo']);

      allow update: if anyRole(['admin', 'admin_joseo', 'assistant_joseo', 'boleteria_joseo']);

      allow delete: if anyRole(['admin', 'admin_joseo', 'assistant_joseo'])
        || (resource.data.status == 'disputa' && resource.data.expiresAt <= request.time.toMillis());
    }

    match /caja_joseo/{movimientoId} {
      allow read, write: if anyRole(['admin', 'admin_joseo', 'assistant_joseo', 'boleteria_joseo']);
    }

    // --- Soporte multi-cliente / sedes externas ---

    match /clientes_externos/{clienteId} {
      allow read: if true;
      allow write: if hasRole('admin') || request.auth != null
        || (resource == null)
        || (
          (!('bloqueada' in resource.data) || resource.data.bloqueada != true) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mesas', 'bloqueada'])
        );

      match /reservas/{mesaId} {
        allow read: if true;

        allow create: if (
            request.resource.data.status in ['pendiente', 'disputa']
            && request.resource.data.nombre is string
            && request.resource.data.nombre.size() > 0
            && request.resource.data.contacto is string
            && request.resource.data.ts is int
          )
          || request.auth != null
          || demoNoBloqueada(clienteId);

        allow update: if request.auth != null
          || demoNoBloqueada(clienteId);

        allow delete: if request.auth != null
          || (resource.data.status == 'disputa' && resource.data.expiresAt <= request.time.toMillis())
          || demoNoBloqueada(clienteId);
      }

      match /caja/{movimientoId} {
        allow read, write: if request.auth != null
          || demoNoBloqueada(clienteId);
      }
    }
  }
}
